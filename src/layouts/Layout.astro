---
import '../styles/global.css';
import TitleScreen from '../components/TitleScreen.astro';
import QuestJournal from '../components/QuestJournal.astro';
import Scenery from '../components/Scenery.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Personal portfolio showcasing software engineering projects and work experience.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Google Fonts: Fraunces (Storybook Serif), Nunito (Warm Sans), JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400&family=JetBrains+Mono:wght@400;500&family=Nunito:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Set theme + title-screen state before paint (storage access can throw, so guard it) -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var theme = null, seen = null;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        try { seen = sessionStorage.getItem('forest-title-seen'); } catch (e) {}
        var dark = theme ? theme === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        root.classList.toggle('dark', dark);
        if (!seen) root.classList.add('show-title');

        // Weather survives reloads within the session.
        var wx = null;
        // Season + weather survive reloads within the session; a first visit
        // starts at a random season with one of its own weathers (mostly calm).
        var season = null;
        try { wx = sessionStorage.getItem('weather'); season = sessionStorage.getItem('season'); } catch (e) {}
        var seasons = {
          spring: ['clear', 'clear', 'sakura', 'sakura', 'haze', 'sunshower'],
          tsuyu: ['drizzle', 'drizzle', 'rain', 'mist'],
          summer: ['clear', 'clear', 'heat', 'storm', 'sunshower'],
          typhoon: ['breeze', 'breeze', 'rain', 'typhoon'],
          autumn: ['clear', 'clear', 'momiji', 'momiji', 'mist', 'rain'],
          winter: ['clear', 'snow', 'snow', 'blizzard', 'breeze']
        };
        if (!season || !seasons[season]) {
          var names = Object.keys(seasons);
          season = names[Math.floor(Math.random() * names.length)];
          wx = null;
        }
        var auto = null;
        try { auto = localStorage.getItem('auto-weather'); } catch (e) {}
        if (!wx) {
          var pool = auto === 'off' ? ['clear'] : seasons[season];
          wx = pool[Math.floor(Math.random() * pool.length)];
          if (auto === 'off' && seasons[season].indexOf('clear') < 0) wx = seasons[season][0];
        }
        root.dataset.season = season;
        root.dataset.weather = wx;

        // Graphics quality: saved choice, else auto-detect low-power devices.
        var gfx = null;
        try { gfx = localStorage.getItem('gfx'); } catch (e) {}
        var nav = navigator, conn = nav.connection || {};
        var weak = (nav.deviceMemory && nav.deviceMemory <= 4) ||
          (nav.hardwareConcurrency && nav.hardwareConcurrency <= 4) || conn.saveData === true;
        if (gfx === 'lite' || (gfx !== 'full' && weak)) root.classList.add('lite');
      })();
    </script>
  </head>
  <body
    class="text-[#222b25] dark:text-[#f4efe2] antialiased selection:bg-[#2b6e4c]/20 selection:text-[#1f5238] dark:selection:bg-[#f3b354]/25 dark:selection:text-[#f3b354] transition-colors duration-300 min-h-screen flex flex-col relative overflow-x-hidden"
  >
    <a href="#main" class="skip-link">Skip to content</a>
    <TitleScreen />

    <!-- Hand-painted satoyama countryside (day meadow / moonlit night) -->
    <Scenery />

    <slot />

    <QuestJournal />
    <div data-toast-region class="toast-region" role="status" aria-live="polite"></div>
    <div id="forest-tip" class="forest-tip" role="tooltip" hidden><Icon name="leaf" class="forest-tip__icon" /><span class="forest-tip__text"></span><span class="forest-tip__arrow" aria-hidden="true"></span></div>

    <script>
      import '../scripts/game';
    </script>
  </body>
</html>
