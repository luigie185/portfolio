---
import { projects } from '../data/portfolio';
import Acorn from './Acorn.astro';
import ChapterHeading from './ChapterHeading.astro';
---

<section data-section-quest="relics" id="projects" class="py-14 scroll-mt-20 border-t-2 border-dashed border-[#c59b47]/50">
  <ChapterHeading
    chapter="Chapter III"
    eyebrow="📖 Artifact Compendium"
    title="Forged Relics & Spells (Featured Projects)"
    badge={`DISCOVERED RELICS: ${projects.length} / ${projects.length}`}
  />

  <!-- RPG Grimoire Inventory Grid -->
  <div class="relative grid grid-cols-1 md:grid-cols-2 gap-6">
    <Acorn id="relics" class="-top-5 left-1/2 z-20" />
    {
      projects.map((project) => (
        <article class="rpg-panel group relative flex flex-col justify-between p-6 rounded-3xl hover:-translate-y-1 transition-all duration-300">
          <div>
            <!-- Top Artifact ID, Element & Rarity Stars -->
            <div class="flex items-center justify-between gap-2 pb-3 mb-3 border-b border-[#dfd3b8] dark:border-[#2e4063]">
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-[#23476e] text-[#fff8e7]">
                  {project.id}
                </span>
                <span class="text-xs font-mono font-semibold text-[#2e7050] dark:text-[#59c49d]">
                  {project.element}
                </span>
              </div>

              <!-- Gold Rarity Stars -->
              <div class="text-xs tracking-tighter text-[#d4712a] dark:text-[#f3b354]" title={`Rarity: ${project.rarity} Stars`}>
                {'★'.repeat(project.rarity)}
              </div>
            </div>

            <!-- Title & Lore Description -->
            <h3 class="text-xl font-bold text-[#252b27] dark:text-[#f5efe2] group-hover:text-[#2e7050] dark:group-hover:text-[#f3b354] transition-colors">
              {project.title}
            </h3>
            <p class="mt-2 text-sm text-[#434c44] dark:text-[#c7d3e6] leading-relaxed">
              {project.summary}
            </p>
          </div>

          <!-- Bottom: Power Output, Runes & Portal Action Buttons -->
          <div class="mt-6 pt-4 border-t border-[#dfd3b8] dark:border-[#2e4063] space-y-4">
            {project.metrics && (
              <div class="flex items-center justify-between text-xs font-mono px-3 py-1.5 rounded-xl bg-[#f2e7ce] dark:bg-[#1a263d] text-[#d4712a] dark:text-[#f3b354] font-semibold">
                <span>⚡ MANA OUTPUT</span>
                <span>{project.metrics}</span>
              </div>
            )}

            <div class="flex flex-wrap gap-1.5">
              {project.technologies.map((tech) => (
                <span class="px-2.5 py-0.5 text-xs font-mono font-semibold rounded-lg bg-[#efe5ce] dark:bg-[#212f47] text-[#252b27] dark:text-[#d6e1f0] border border-[#c59b47]/40">
                  {tech}
                </span>
              ))}
            </div>

            <!-- Interactive Portal / Scroll Buttons -->
            <div class="flex items-center gap-2.5 pt-1">
              {project.liveUrl && (
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 text-center py-2 px-3 rounded-xl text-xs font-mono font-bold bg-[#2e7050] text-[#fff8e7] hover:bg-[#23593e] dark:bg-[#f3b354] dark:text-[#111927] dark:hover:bg-[#f7c474] transition-colors"
                >
                  🌀 OPEN PORTAL (DEMO)
                </a>
              )}
              {project.repoUrl && (
                <a
                  href={project.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="py-2 px-3.5 rounded-xl text-xs font-mono font-bold border border-[#c59b47] bg-[#fffaf0] dark:bg-[#182338] text-[#252b27] dark:text-[#f5efe2] hover:bg-[#f0e4c8] dark:hover:bg-[#22314d] transition-colors"
                >
                  📜 SOURCE SCROLL
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
