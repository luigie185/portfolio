---
import { projects } from '../data/portfolio';
import Acorn from './Acorn.astro';
import ChapterHeading from './ChapterHeading.astro';
import RelicVignette from './RelicVignette.astro';
---

<section data-section-quest="relics" id="projects" class="py-14 scroll-mt-20">
  <ChapterHeading
    chapter="Chapter III"
    eyebrow="📖 The Relic Cabinet · Featured Projects"
    title="Things I've Made"
    badge={`RELICS FOUND: ${projects.length} / ${projects.length}`}
  />

  <div class="relative grid grid-cols-1 md:grid-cols-2 gap-7">
    <Acorn id="relics" class="-top-6 left-1/2 z-20" />
    {
      projects.map((project) => (
        <article class="relic-card group">
          <!-- gilt leaf corners -->
          <svg class="relic-corner relic-corner--tl" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 22C2 10 10 2 22 2c-2 6-6 8-10 9 4 0 6 1 8 3-6 0-10 1-12 4 0-3-1-5-6 4Z" /></svg>
          <svg class="relic-corner relic-corner--tr" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 22C2 10 10 2 22 2c-2 6-6 8-10 9 4 0 6 1 8 3-6 0-10 1-12 4 0-3-1-5-6 4Z" /></svg>

          <!-- painted card art -->
          <div class="relic-art">
            <RelicVignette emblem={project.emblem} sky={project.sky} uid={`relic-${project.emblem}`} />
            <span class="relic-number">{project.id}</span>
            <span class="relic-rarity" tabindex="0" data-tip={`Rarity ${project.rarity} of 5`} aria-label={`Rarity ${project.rarity} of 5`}>
              {Array.from({ length: 5 }, (_, s) => (
                <span class={s < project.rarity ? 'is-on' : ''} aria-hidden="true">★</span>
              ))}
            </span>
          </div>

          <div class="relic-body">
            <p class="text-[11px] font-mono font-bold uppercase tracking-wider text-[#2e7050] dark:text-[#59c49d]">
              {project.element}
            </p>
            <h3 class="mt-1 text-2xl font-bold leading-tight text-[#2a2620] dark:text-[#f5efe2]">
              {project.title}
            </h3>
            <p class="text-sm font-semibold text-[#23476e] dark:text-[#8cc4f0]">{project.kind}</p>

            <p class="relic-lore">“{project.lore}”</p>

            <p class="mt-3 text-[0.92rem] text-[#3d3a33] dark:text-[#cdd7e6] leading-relaxed">{project.summary}</p>

            <dl class="mt-4 flex flex-wrap gap-2">
              {project.stats.map((stat) => (
                <div class="relic-stat">
                  <dt class="sr-only">Highlight</dt>
                  <dd><span aria-hidden="true">✦</span> {stat}</dd>
                </div>
              ))}
            </dl>

            <div class="mt-4 flex flex-wrap gap-1.5">
              <span class="sr-only">Built with:</span>
              {project.technologies.map((tech) => (
                <span class="seed-tag">{tech}</span>
              ))}
            </div>

            <div class="mt-auto pt-5 flex items-center gap-2.5">
              {project.liveUrl && (
                <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="signpost signpost--primary">
                  Visit <span aria-hidden="true">→</span><span class="sr-only"> {project.title} demo</span>
                </a>
              )}
              {project.repoUrl && (
                <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="signpost">
                  Source<span class="sr-only"> code for {project.title}</span>
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
