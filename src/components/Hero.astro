---
import Icon from './Icon.astro';
import { dialogue, profile } from '../data/portfolio';
import Acorn from './Acorn.astro';
import ForestSpirit from './ForestSpirit.astro';
import fs from 'node:fs';
import path from 'node:path';

// Profile photo: drop public/Profile.(png|jpg|jpeg|webp|avif) in and it's used automatically.
// Prefers the optimized public/profile.webp (made by `npm run photo`); matching is
// case-insensitive so Profile.png works too.
const publicFiles = fs.existsSync(path.join(process.cwd(), 'public')) ? fs.readdirSync(path.join(process.cwd(), 'public')) : [];
const photoFile = ['webp', 'avif', 'jpg', 'jpeg', 'png']
  .map((ext) => publicFiles.find((f) => f.toLowerCase() === `profile.${ext}`))
  .find(Boolean);
const photo = photoFile ? `/${photoFile}` : null;
---

<section id="about" class="pt-10 pb-14 sm:pt-14 sm:pb-[4.5rem] space-y-6">
  <!-- Character sheet: washi paper, gilt edge -->
  <div class="hero-sheet relative">
    <Acorn id="hero" class="bottom-3 right-4 z-20" />

    <!-- Hand-drawn camphor sprig peeking from behind the ledger -->
    <svg
      aria-hidden="true"
      class="pointer-events-none absolute hidden lg:block -right-3 top-[10.5rem] w-48 h-36 opacity-90 dark:opacity-50"
      viewBox="0 0 220 170"
      fill="none"
    >
      <path d="M215 6 C170 30 130 60 92 104 C70 128 52 146 30 160" stroke="#7a5a3a" stroke-width="3" stroke-linecap="round" />
      <path d="M150 44 C150 22 170 8 192 8 C190 30 172 44 150 44Z" fill="#5f9f4f" />
      <path d="M128 64 C108 50 84 54 72 70 C92 82 114 80 128 64Z" fill="#7bb85a" />
      <path d="M112 84 C116 62 136 48 158 52 C152 74 134 86 112 84Z" fill="#4f9248" />
      <path d="M80 116 C60 104 38 110 28 126 C48 136 68 132 80 116Z" fill="#8cc464" />
      <circle cx="176" cy="34" r="5" fill="#2b4a3a" /><circle cx="186" cy="40" r="4.5" fill="#2b4a3a" />
    </svg>

    <!-- Quick facts (recruiter view only) -->
    <div class="recruiter-only recruiter-facts" aria-label="Quick facts">
      <p class="recruiter-facts__lead">
        <strong>{profile.name}</strong> · {profile.role} · {profile.location}
      </p>
      <ul class="recruiter-facts__links">
        <li><a href={`mailto:${profile.email}`} data-quest="pigeon">{profile.email}</a></li>
        <li><a href={profile.socials.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <li><a href={profile.socials.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        <li><a href="#experience">Experience</a></li>
        <li><a href="#projects">Projects</a></li>
      </ul>
      <button type="button" data-recruiter-toggle class="recruiter-facts__exit">Back to the full adventure →</button>
    </div>

    <!-- Header ribbon -->
    <div class="relative z-10 flex flex-wrap items-center justify-between gap-3 pb-5 mb-7 hero-rule">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-[#23476e] dark:text-[#f3b354]">
        <span class="font-serif-story italic normal-case tracking-normal text-sm whitespace-nowrap text-[#c27a2c] dark:text-[#f3b354]"><Icon name="leaf" class="ornament" /> Chapter I <Icon name="leaf" class="ornament ornament--flip" /></span>
        <span class="text-[#c59b47]" aria-hidden="true">·</span>
        <span>The Traveler's Registry</span>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-9 items-start relative z-10">
      <!-- Left: who, what, and how to reach -->
      <div class="lg:col-span-7">
        <div class="flex items-center gap-4">
          <!-- Leaf-wreath crest framing the profile photo (or the initial) -->
          <div class:list={['hero-crest', photo && 'hero-crest--photo']}>
            <svg viewBox="0 0 80 80">
              <circle cx="40" cy="40" r="34" class="hero-crest__disc" />
              <circle cx="40" cy="40" r="34" fill="none" stroke="#c59b47" stroke-width="2.5" />
              <circle cx="40" cy="40" r="29" fill="none" stroke="#c59b47" stroke-width="1" stroke-dasharray="2 3" />
              <g fill="#5f9f4f">
                {Array.from({ length: 9 }, (_, i) => {
                  const a = (200 + i * 17) * (Math.PI / 180);
                  const x = 40 + Math.cos(a) * 33, y = 40 + Math.sin(a) * 33;
                  return <ellipse cx={x} cy={y} rx="5" ry="2.4" transform={`rotate(${200 + i * 17 + 70} ${x} ${y})`} />;
                })}
                {Array.from({ length: 9 }, (_, i) => {
                  const a = (-20 - i * 17) * (Math.PI / 180);
                  const x = 40 + Math.cos(a) * 33, y = 40 + Math.sin(a) * 33;
                  return <ellipse cx={x} cy={y} rx="5" ry="2.4" transform={`rotate(${-20 - i * 17 - 70} ${x} ${y})`} />;
                })}
              </g>
              {!photo && <text x="40" y="50" text-anchor="middle" class="hero-crest__letter" aria-hidden="true">{profile.shortName.charAt(0)}</text>}
            </svg>
            {photo && (
              <img
                src={photo}
                alt={`Portrait of ${profile.name}`}
                class="hero-crest__photo"
                width="160"
                height="160"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            )}
            <span class="hero-crest__level">LV {profile.level}</span>
          </div>

          <div class="min-w-0">
            <p class="hero-class"><Icon name="swords" /> {profile.rpgClass}</p>
            <p class="mt-1 text-sm font-semibold text-[#2e7050] dark:text-[#59c49d]">
              {profile.role} · {profile.location}
            </p>
          </div>
        </div>

        <h1 class="hero-name mt-5">
          {profile.name}
          <svg class="hero-name__brush" viewBox="0 0 400 18" preserveAspectRatio="none" aria-hidden="true">
            <path d="M4 12 C80 4 160 15 240 8 S360 6 396 10" />
          </svg>
        </h1>

        <p class="mt-4 text-base sm:text-lg font-serif-story italic text-[#2e7050] dark:text-[#6ee7b7]">
          “{profile.tagline}”
        </p>

        <p class="mt-3 text-[0.95rem] sm:text-base text-[#49524a] dark:text-[#c2cfe3] leading-relaxed max-w-prose">
          {profile.about}
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a href="#projects" class="signpost signpost--primary signpost--lg">
            See my work <span aria-hidden="true">→</span>
          </a>
          <a href={`mailto:${profile.email}`} data-quest="pigeon" class="signpost signpost--lg">
            <Icon name="bird" /> Say hello
          </a>
          <a
            href={profile.socials.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub (@luigie185)"
            class="signpost signpost--lg"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
            </svg>
            GitHub
          </a>
        </div>
      </div>

      <!-- Right: the Spirit Ledger (stats) -->
      <div class="lg:col-span-5">
        <div class="ledger">
          <div class="ledger__head">
            <span class="ledger__title"><Icon name="sparkles" /> Spirit Ledger</span>
            <span class="ledger__sub">Skill levels</span>
          </div>

          <ul class="mt-4 space-y-4">
            {
              profile.attributes.map((attr, i) => (
                <li class="ledger-row" style={`--d:${0.15 + i * 0.12}s`}>
                  <span class="ledger-row__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      {attr.icon === 'brush' && <path d="M14 3c3 0 7 4 7 7-3 0-4 2-6 4l-3-3c2-2 4-3 4-6-1 0-2-1-2-2Zm-4 9 3 3c-1 3-3 6-8 6 0-5 3-7 5-9Z" />}
                      {attr.icon === 'gear' && <path d="M10.5 2h3l.5 2.6 2 .9 2.2-1.5 2.1 2.1-1.5 2.2.9 2 2.6.5v3l-2.6.5-.9 2 1.5 2.2-2.1 2.1-2.2-1.5-2 .9-.5 2.6h-3l-.5-2.6-2-.9-2.2 1.5-2.1-2.1 1.5-2.2-.9-2L2 13.5v-3l2.6-.5.9-2L4 5.8l2.1-2.1L8.3 5.2l2-.9ZM12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" />}
                      {attr.icon === 'compass' && <path d="M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20Zm0 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm4 4-2.5 6L8 16.5 10.5 10Zm-4 3a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z" />}
                      {attr.icon === 'feather' && <path d="M20 3c-7 0-13 5-14 13l-2 4 1.5.5L7 17c4 0 9-2 11-6h-4l5-2c1-2 1-4 1-6Z" />}
                    </svg>
                  </span>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-baseline justify-between gap-2">
                      <span class="ledger-row__name">{attr.name}</span>
                      <span class="ledger-row__value">{attr.stat}<span class="ledger-row__max">/100</span></span>
                    </div>
                    <div
                      class="ledger-gauge"
                      role="meter"
                      aria-label={attr.name}
                      aria-valuemin="0"
                      aria-valuemax="100"
                      aria-valuenow={attr.stat}
                    >
                      <span class="ledger-gauge__fill" style={`--v:${attr.stat / 100}`} />
                    </div>
                    <p class="ledger-row__note">{attr.note}</p>
                  </div>
                </li>
              ))
            }
          </ul>

          <ul class="mt-5 grid grid-cols-3 gap-2">
            {
              profile.highlights.map((item) => (
                <li class="perk-seal">
                  <span class="perk-seal__icon"><Icon name={item.icon} /></span>
                  <span class="perk-seal__label">{item.label}</span>
                  <span class="perk-seal__value">{item.value}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Forest spirit guide: RPG dialogue window with typewriter text -->
  <div data-dialogue-box class="dialogue-sheet relative">
    <Acorn id="dialogue" class="-bottom-3 right-6 z-20" />

    <!-- name plate tab -->
    <div class="dialogue-nameplate">
      <Icon name="leaf" /> {dialogue.speaker}
    </div>

    <div class="flex flex-col sm:flex-row items-center sm:items-start gap-4 sm:gap-6">
      <!-- Mori's portrait (pat for a reaction) -->
      <button
        type="button"
        data-pat-spirit
        data-tip="Give Mori a gentle pat"
        aria-label="Pat Mori, the forest spirit"
        class="dialogue-portrait spirit-avatar"
      >
        <ForestSpirit standalone class="w-[4.5rem] h-[4.5rem]" />
      </button>

      <div class="flex-1 w-full min-w-0">
        <!-- speech bubble -->
        <div class="dialogue-bubble">
          <!-- Screen readers get the full line once; the animated copy is hidden from them -->
          <p class="sr-only" aria-live="polite" data-dialogue-sr>{dialogue.greeting}</p>
          <p aria-hidden="true" class="dialogue-text">
            <span data-dialogue-visible>{dialogue.greeting}</span><span data-dialogue-caret class="dialogue-caret">▼</span>
          </p>
        </div>

        <div class="mt-4 grid gap-3 sm:grid-cols-[1fr_auto] sm:items-start">
          <div>
            <p class="dialogue-group-label">Ask Mori</p>
            <div class="flex flex-wrap gap-2" role="group" aria-label="Ask Mori">
              {
                dialogue.options.map((opt, i) => (
                  <button type="button" data-dialogue-option={i} class="npc-choice dialogue-option">
                    <span class="npc-choice__cursor" aria-hidden="true">▸</span>
                    <span>{opt.label}</span>
                  </button>
                ))
              }
            </div>
          </div>
          <div>
            <p class="dialogue-group-label">Cast a spell</p>
            <div class="flex flex-wrap gap-2" role="group" aria-label="Spells">
              <button type="button" data-theme-toggle aria-pressed="false" data-tip="Switch day and night · N" class="npc-choice dialogue-spell">
                <Icon name="wand" /><span>Time-Shift</span>
              </button>
              <button type="button" data-weather-cycle data-tip="Change the weather · R" class="npc-choice dialogue-spell">
                <Icon name="clear" /><span>Weather</span>
              </button>
            </div>
          </div>
        </div>

        <p class="dialogue-hint">
          Click the text to skip · <kbd>J</kbd> journal · <kbd>1</kbd><kbd>2</kbd><kbd>3</kbd> travel
        </p>
      </div>
    </div>
  </div>
</section>
