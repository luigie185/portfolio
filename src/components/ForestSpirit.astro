---
/**
 * "Mori" — the site's own forest spirit (an original character): a round,
 * moss-soft sprite with a two-leaf sprout, rosy cheeks and a treasured acorn.
 *
 * - Idle: breathes, blinks, sprout sways.
 * - `.is-happy` (added by the game on rewards): hops, grins, sparkles.
 * - Night: carries a little glowing paper lantern.
 *
 * Renders as an SVG <g> (inside the scenery) or as a standalone <svg>.
 * Colours come from CSS variables on [data-spirit] (see global.css).
 */
interface Props {
  standalone?: boolean;
  stone?: boolean;
  class?: string;
}
const { standalone = false, stone = true, class: className } = Astro.props;
---

{
  standalone ? (
    <svg data-spirit class:list={['spirit-svg', className]} viewBox="-56 -82 112 108" aria-hidden="true">
      <ellipse cx="0" cy="13" rx="30" ry="5" class="spirit-ground-shadow" />
      <g class="spirit">
        <g class="spirit-hop">
          <g class="spirit-breathe">
            <path class="spirit-sprout spirit-stem" d="M0-46 C-1-54 0-60 2-64" />
            <path class="spirit-sprout spirit-leaf" d="M2-62 C-10-74-22-66-20-60 C-12-56-2-58 2-62Z" />
            <path class="spirit-sprout spirit-leaf-lit" d="M2-62 C10-76 26-72 24-64 C16-58 6-58 2-62Z" />
            <path class="spirit-body" d="M-30 4 C-34-26-18-48 0-48 C18-48 34-26 30 4 C26 14-26 14-30 4Z" />
            <path class="spirit-lit" d="M-22-30 C-16-42-4-46 6-44 C-6-40-14-34-18-24Z" />
            <path class="spirit-shade" d="M30 4 C34-14 28-30 18-40 C26-24 26-8 20 8Z" />
            <g class="spirit-eyes">
              <circle cx="-9" cy="-20" r="3.2" class="spirit-eye" /><circle cx="9" cy="-20" r="3.2" class="spirit-eye" />
              <circle cx="-8" cy="-21.3" r="1" fill="#fff" /><circle cx="10" cy="-21.3" r="1" fill="#fff" />
            </g>
            <ellipse cx="-17" cy="-12" rx="5" ry="3" class="spirit-cheek" />
            <ellipse cx="17" cy="-12" rx="5" ry="3" class="spirit-cheek" />
            <path class="spirit-mouth" d="M-3-13 Q0-10 3-13" />
            <path class="spirit-mouth-happy" d="M-4.5-14 Q0-7 4.5-14Z" />
            <g transform="translate(0 -2)">
              <path d="M-7 0 C-7-4 7-4 7 0 Z" fill="#7a5a3a" />
              <path d="M-6 0 C-6 7 6 7 6 0Z" fill="#c98a3d" />
              <path class="spirit-arms" d="M-12 2 Q-8-2-6 1 M12 2 Q8-2 6 1" />
            </g>
            <ellipse cx="-12" cy="9" rx="7" ry="4" class="spirit-foot" /><ellipse cx="12" cy="9" rx="7" ry="4" class="spirit-foot" />
          </g>
        </g>
        <g class="spirit-lantern">
          <circle cx="40" cy="-14" r="16" class="spirit-lantern-glow" />
          <path d="M26 -4 L38 -28" class="spirit-lantern-stick" />
          <path d="M38 -28 v4" class="spirit-lantern-stick" />
          <rect x="33" y="-24" width="11" height="15" rx="4" class="spirit-lantern-paper" />
          <path d="M33 -19h11M33 -14h11" class="spirit-lantern-rib" />
        </g>
        <g class="spirit-sparkles">
          <path d="M-36-50 l2 5 5 2 -5 2 -2 5 -2-5 -5-2 5-2Z" />
          <path d="M34-58 l1.6 4 4 1.6 -4 1.6 -1.6 4 -1.6-4 -4-1.6 4-1.6Z" />
          <path d="M-42-12 l1.4 3.5 3.5 1.4 -3.5 1.4 -1.4 3.5 -1.4-3.5 -3.5-1.4 3.5-1.4Z" />
          <path d="M44-28 l1.4 3.5 3.5 1.4 -3.5 1.4 -1.4 3.5 -1.4-3.5 -3.5-1.4 3.5-1.4Z" />
        </g>
      </g>
    </svg>
  ) : (
    <g data-spirit class={className}>
      {stone && (
        <>
          <ellipse cx="0" cy="24" rx="46" ry="16" style="fill:var(--scene-stone-shadow)" />
          <path d="M-42 20 C-40 4-20-2 0-2 C22-2 42 4 44 20 C30 30-30 30-42 20Z" style="fill:var(--scene-stone)" />
          <path d="M-36 8 C-20-2 10-4 30 4 C14 2-14 4-36 12Z" style="fill:var(--scene-moss)" />
        </>
      )}
      <g class="spirit" transform="translate(0 2) scale(.9)">
        <g class="spirit-hop">
          <g class="spirit-breathe">
            <path class="spirit-sprout spirit-stem" d="M0-46 C-1-54 0-60 2-64" />
            <path class="spirit-sprout spirit-leaf" d="M2-62 C-10-74-22-66-20-60 C-12-56-2-58 2-62Z" />
            <path class="spirit-sprout spirit-leaf-lit" d="M2-62 C10-76 26-72 24-64 C16-58 6-58 2-62Z" />
            <path class="spirit-body" d="M-30 4 C-34-26-18-48 0-48 C18-48 34-26 30 4 C26 14-26 14-30 4Z" />
            <path class="spirit-lit" d="M-22-30 C-16-42-4-46 6-44 C-6-40-14-34-18-24Z" />
            <path class="spirit-shade" d="M30 4 C34-14 28-30 18-40 C26-24 26-8 20 8Z" />
            <g class="spirit-eyes">
              <circle cx="-9" cy="-20" r="3.2" class="spirit-eye" /><circle cx="9" cy="-20" r="3.2" class="spirit-eye" />
              <circle cx="-8" cy="-21.3" r="1" fill="#fff" /><circle cx="10" cy="-21.3" r="1" fill="#fff" />
            </g>
            <ellipse cx="-17" cy="-12" rx="5" ry="3" class="spirit-cheek" />
            <ellipse cx="17" cy="-12" rx="5" ry="3" class="spirit-cheek" />
            <path class="spirit-mouth" d="M-3-13 Q0-10 3-13" />
            <path class="spirit-mouth-happy" d="M-4.5-14 Q0-7 4.5-14Z" />
            <g transform="translate(0 -2)">
              <path d="M-7 0 C-7-4 7-4 7 0 Z" fill="#7a5a3a" />
              <path d="M-6 0 C-6 7 6 7 6 0Z" fill="#c98a3d" />
              <path class="spirit-arms" d="M-12 2 Q-8-2-6 1 M12 2 Q8-2 6 1" />
            </g>
            <ellipse cx="-12" cy="9" rx="7" ry="4" class="spirit-foot" /><ellipse cx="12" cy="9" rx="7" ry="4" class="spirit-foot" />
          </g>
        </g>
        <g class="spirit-lantern">
          <circle cx="40" cy="-14" r="22" class="spirit-lantern-glow" />
          <path d="M26 -4 L38 -28" class="spirit-lantern-stick" />
          <path d="M38 -28 v4" class="spirit-lantern-stick" />
          <rect x="33" y="-24" width="11" height="15" rx="4" class="spirit-lantern-paper" />
          <path d="M33 -19h11M33 -14h11" class="spirit-lantern-rib" />
        </g>
        <g class="spirit-sparkles">
          <path d="M-36-50 l2 5 5 2 -5 2 -2 5 -2-5 -5-2 5-2Z" />
          <path d="M34-58 l1.6 4 4 1.6 -4 1.6 -1.6 4 -1.6-4 -4-1.6 4-1.6Z" />
          <path d="M-42-12 l1.4 3.5 3.5 1.4 -3.5 1.4 -1.4 3.5 -1.4-3.5 -3.5-1.4 3.5-1.4Z" />
          <path d="M44-28 l1.4 3.5 3.5 1.4 -3.5 1.4 -1.4 3.5 -1.4-3.5 -3.5-1.4 3.5-1.4Z" />
        </g>
      </g>
    </g>
  )
}
