---
/**
 * Floating HUD bubble, docked at the bottom centre of the screen on every
 * device. It replaces the old top header + mobile dock:
 *   [traveler crest with XP ring] | chapter tabs | acorns · weather · day/night
 */
import { ACORN_IDS, WEATHERS, XP_PER_LEVEL } from '../data/portfolio';

const links = [
  { href: '#about', icon: '✦', label: 'Status' },
  { href: '#experience', icon: '📜', label: 'Quests' },
  { href: '#projects', icon: '📖', label: 'Relics' },
];
const RING = 2 * Math.PI * 20; // XP ring circumference (r = 20)
---

<nav class="hud-bubble" data-hud aria-label="Game menu">
  <!-- Traveler crest: level in the middle, XP as a ring around it -->
  <a
    href="#about"
    class="hud-bubble__crest"
    data-hud-badge
    data-hud-crest
    data-tip={`Traveler LV 1 · 0/${XP_PER_LEVEL} XP`}
  >
    <svg viewBox="0 0 48 48" aria-hidden="true">
      <circle cx="24" cy="24" r="20" class="hud-ring__track" />
      <circle
        cx="24"
        cy="24"
        r="20"
        class="hud-ring__fill"
        data-hud-xp-ring
        style={`stroke-dasharray:${RING.toFixed(2)};stroke-dashoffset:${RING.toFixed(2)}`}
      />
      <circle cx="24" cy="24" r="15.5" class="hud-ring__disc" />
      <text x="24" y="21" text-anchor="middle" class="hud-ring__lv">LV</text>
      <text x="24" y="32" text-anchor="middle" class="hud-ring__num" data-hud-level>1</text>
    </svg>
    <span class="sr-only">
      Traveler level <span data-hud-level>1</span>, <span data-hud-xp>0/{XP_PER_LEVEL}</span> experience. Back to top.
    </span>
  </a>

  <span class="hud-bubble__sep" aria-hidden="true"></span>

  <!-- Chapters -->
  <div class="hud-bubble__tabs">
    {
      links.map((l) => (
        <a href={l.href} class="hud-bubble__tab" data-nav-link={l.href.slice(1)} data-tip={l.label}>
          <span class="hud-bubble__icon" aria-hidden="true">{l.icon}</span>
          <span class="hud-bubble__label">{l.label}</span>
        </a>
      ))
    }
  </div>

  <span class="hud-bubble__sep" aria-hidden="true"></span>

  <!-- Tokens -->
  <button
    type="button"
    data-open-journal
    data-tip="Acorns found · open the journal (J)"
    aria-label="Open quest journal (J)"
    class="hud-bubble__token hud-bubble__token--wide"
  >
    <span aria-hidden="true">🌰</span>
    <span data-hud-acorns>0/{ACORN_IDS.length}</span>
  </button>

  <button
    type="button"
    data-weather-cycle
    data-hud-weather-btn
    aria-label={`Change the weather (R). Now: ${WEATHERS[0].label}`}
    data-tip="Weather: Clear skies · R to change"
    class="hud-bubble__token"
  >
    <span data-hud-weather aria-hidden="true">{WEATHERS[0].icon}</span>
  </button>

  <button
    type="button"
    data-theme-toggle
    data-hud-theme-btn
    data-tip="Day / night spell · N"
    aria-label="Toggle night mode (N)"
    aria-pressed="false"
    class="hud-bubble__token"
  >
    <span class="hidden dark:inline" aria-hidden="true">🌅</span>
    <span class="dark:hidden" aria-hidden="true">🌙</span>
  </button>
</nav>
