---
/**
 * Floating HUD bubble, docked at the bottom centre of the screen on every
 * device. It replaces the old top header + mobile dock:
 *   [your level crest] | chapter tabs | acorns · weather · day/night
 */
import { ACORN_IDS, WEATHERS, profile } from '../data/portfolio';
import Icon from './Icon.astro';
import type { IconName } from '../scripts/icons';

const links = [
  { href: '#about', icon: 'sparkles', label: 'Status' },
  { href: '#experience', icon: 'scroll', label: 'Quests' },
  { href: '#projects', icon: 'book', label: 'Relics' },
] satisfies { href: string; icon: IconName; label: string }[];
---

<nav class="hud-bubble" data-hud aria-label="Game menu">
  <!-- Your crest: your level, with a gilt ring. Hover/focus shows your name. -->
  <a href="#about" class="hud-bubble__crest" data-level-crest>
    <span class="hud-nameplate" aria-hidden="true">
      <span class="hud-nameplate__name">{profile.name}</span>
      <span class="hud-nameplate__meta">LV <span data-my-level>{profile.level}</span> · Coding since {profile.codingYear}</span>
      <span class="hud-nameplate__detail" data-level-detail></span>
    </span>
    <svg viewBox="0 0 48 48" aria-hidden="true">
      <circle cx="24" cy="24" r="20" class="hud-ring__track" />
      <circle cx="24" cy="24" r="20" class="hud-ring__fill hud-ring__fill--full" />
      <circle cx="24" cy="24" r="15.5" class="hud-ring__disc" />
      <text x="24" y="21" text-anchor="middle" class="hud-ring__lv">LV</text>
      <text x="24" y="32" text-anchor="middle" class="hud-ring__num" data-my-level>{profile.level}</text>
    </svg>
    <span class="sr-only">{profile.name}, level <span data-my-level>{profile.level}</span>, coding since {profile.codingYear}. Back to top.</span>
  </a>

  <span class="hud-bubble__sep" aria-hidden="true"></span>

  <!-- Chapters -->
  <div class="hud-bubble__tabs">
    {
      links.map((l) => (
        <a href={l.href} class="hud-bubble__tab" data-nav-link={l.href.slice(1)} data-tip={l.label}>
          <span class="hud-bubble__icon"><Icon name={l.icon} /></span>
          <span class="hud-bubble__label">{l.label}</span>
        </a>
      ))
    }
  </div>

  <span class="hud-bubble__sep" aria-hidden="true"></span>

  <!-- Tokens -->
  <button
    type="button"
    data-open-journal
    data-tip="Acorns found · open the journal (J)"
    aria-label="Open quest journal (J)"
    class="hud-bubble__token hud-bubble__token--wide"
  >
    <Icon name="acorn" />
    <span data-hud-acorns>0/{ACORN_IDS.length}</span>
  </button>

  <button
    type="button"
    data-weather-cycle
    data-hud-weather-btn
    aria-label={`Change the weather (R). Now: ${WEATHERS[0].label}`}
    data-tip="Weather: Clear skies · R to change"
    class="hud-bubble__token"
  >
    <span data-hud-weather class="inline-flex"><Icon name={WEATHERS[0].icon} /></span>
  </button>

  <button
    type="button"
    data-sound-toggle
    data-tip="Music & ambience · M"
    aria-label="Sound (M)"
    aria-pressed="true"
    class="hud-bubble__token hud-bubble__token--sound"
  >
    <span class="sound-on inline-flex"><Icon name="volume" /></span>
    <span class="sound-off inline-flex"><Icon name="volumeOff" /></span>
  </button>

  <button
    type="button"
    data-theme-toggle
    data-hud-theme-btn
    data-tip="Day / night spell · N"
    aria-label="Toggle night mode (N)"
    aria-pressed="false"
    class="hud-bubble__token"
  >
    <span class="hidden dark:inline-flex"><Icon name="sunrise" /></span>
    <span class="inline-flex dark:hidden"><Icon name="moon" /></span>
  </button>

  <button
    type="button"
    data-recruiter-toggle
    data-tip="Recruiter view: quick facts, no game · C"
    aria-label="Recruiter view (C)"
    aria-pressed="false"
    class="hud-bubble__token hud-bubble__token--recruiter"
  >
    <Icon name="briefcase" />
  </button>

  <button
    type="button"
    data-open-journal="settings"
    data-tip="Settings & journal (J)"
    aria-label="Settings and journal (J)"
    class="hud-bubble__token hud-bubble__token--settings"
  >
    <Icon name="settings" />
  </button>
</nav>
