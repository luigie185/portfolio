---
import { ACORN_IDS, WEATHERS, XP_PER_LEVEL, profile } from '../data/portfolio';

const links = [
  { href: '#about', icon: '✦', label: 'Status', key: '1' },
  { href: '#experience', icon: '📜', label: 'Quests', key: '2' },
  { href: '#projects', icon: '📖', label: 'Relics', key: '3' },
];
---

<header class="hud sticky top-0 z-50" data-hud>
  <div class="max-w-4xl mx-auto px-3 sm:px-6 h-16 flex items-center justify-between gap-2 sm:gap-3">
    <!-- Left: crest + name + traveler XP -->
    <a href="#about" class="hud-id group" aria-label={`${profile.name} — back to top`}>
      <span data-hud-badge class="hud-badge hud-crest" aria-hidden="true">
        <svg viewBox="0 0 44 44">
          <circle cx="22" cy="22" r="19" class="hud-crest__disc" />
          <circle cx="22" cy="22" r="19" fill="none" stroke="#c59b47" stroke-width="2" />
          <g fill="#5f9f4f">
            {Array.from({ length: 7 }, (_, i) => {
              const a = (205 + i * 22) * (Math.PI / 180);
              const x = 22 + Math.cos(a) * 19, y = 22 + Math.sin(a) * 19;
              return <ellipse cx={x} cy={y} rx="3.2" ry="1.5" transform={`rotate(${205 + i * 22 + 70} ${x} ${y})`} />;
            })}
            {Array.from({ length: 7 }, (_, i) => {
              const a = (-25 - i * 22) * (Math.PI / 180);
              const x = 22 + Math.cos(a) * 19, y = 22 + Math.sin(a) * 19;
              return <ellipse cx={x} cy={y} rx="3.2" ry="1.5" transform={`rotate(${-25 - i * 22 - 70} ${x} ${y})`} />;
            })}
          </g>
          <text x="22" y="20" text-anchor="middle" class="hud-crest__lv">LV</text>
          <text x="22" y="31" text-anchor="middle" class="hud-crest__num">{profile.level}</text>
        </svg>
        <span class="hud-crest__online"></span>
      </span>

      <span class="min-w-0">
        <span class="hud-name">{profile.name}</span>
        <span class="hud-xp">
          <span class="hud-xp__label">You <b>LV.<span data-hud-level>1</span></b></span>
          <span
            class="hud-gauge"
            role="progressbar"
            tabindex="0"
            data-tip="Your traveler XP — explore to level up"
            aria-label="Traveler experience"
            aria-valuemin="0"
            aria-valuemax={XP_PER_LEVEL}
            aria-valuenow="0"
          >
            <span data-hud-xp-bar class="hud-gauge__fill"></span>
          </span>
          <span class="hud-xp__num hidden sm:inline" data-hud-xp>0/{XP_PER_LEVEL}</span>
        </span>
      </span>
    </a>

    <!-- Right: chapter tabs + tokens -->
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      <nav aria-label="Chapters" class="hud-tabs hidden md:flex">
        {
          links.map((l) => (
            <a href={l.href} class="hud-tab" data-nav-link={l.href.slice(1)}>
              <span aria-hidden="true">{l.icon}</span> {l.label}
            </a>
          ))
        }
      </nav>

      <button
        type="button"
        data-open-journal
        data-tip="Acorns found · open the journal (J)"
        aria-label="Open quest journal (J)"
        class="hud-token hud-token--wide"
      >
        <span aria-hidden="true">🌰</span>
        <span data-hud-acorns>0/{ACORN_IDS.length}</span>
      </button>

      <button
        type="button"
        data-weather-cycle
        aria-label={`Change the weather (R). Now: ${WEATHERS[0].label}`}
        data-tip="Weather: Clear skies · R to change"
        class="hud-token"
      >
        <span data-hud-weather aria-hidden="true">{WEATHERS[0].icon}</span>
      </button>

      <button
        type="button"
        data-theme-toggle
        data-tip="Day / night spell · N"
        aria-label="Toggle night mode (N)"
        aria-pressed="false"
        class="hud-token hud-token--theme"
      >
        <span class="hidden dark:inline" aria-hidden="true">☀️</span>
        <span class="dark:hidden" aria-hidden="true">🌙</span>
        <span class="hidden sm:inline">
          <span class="dark:hidden">Nightfall</span><span class="hidden dark:inline">Dawn</span>
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile game command bar (replaces the desktop tabs on small screens) -->
<nav aria-label="Chapters" class="hud-dock md:hidden">
  {
    links.map((l) => (
      <a href={l.href} class="hud-dock__item" data-nav-link={l.href.slice(1)}>
        <span aria-hidden="true" class="hud-dock__icon">{l.icon}</span>
        {l.label}
      </a>
    ))
  }
  <button type="button" data-open-journal class="hud-dock__item">
    <span aria-hidden="true" class="hud-dock__icon">🗺️</span>
    Journal
  </button>
</nav>
