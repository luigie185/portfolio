---
import { experiences } from '../data/portfolio';
import Acorn from './Acorn.astro';
import ChapterHeading from './ChapterHeading.astro';
---

<section data-section-quest="quest-log" id="experience" class="py-14 scroll-mt-20">
  <ChapterHeading
    chapter="Chapter II"
    eyebrow="📜 The Village Notice Board · Work Experience"
    title="The Road So Far"
    badge={`${experiences.length} QUESTS TAKEN`}
  />

  <!-- A winding dirt path with stepping stones; each notice is pinned beside it -->
  <ol class="quest-path relative ml-3 sm:ml-5 space-y-10">
    {
      experiences.map((exp, i) => (
        <li class="relative pl-9 sm:pl-12">
          <span
            class:list={['quest-stone', exp.current && 'quest-stone--current']}
            aria-hidden="true"
          />

          <article class:list={['notice', i % 2 ? 'notice--tilt-r' : 'notice--tilt-l']}>
            <span class="notice-peg" aria-hidden="true" />

            <!-- Rank seal, stamped in red ink -->
            <div class="notice-seal" tabindex="0" data-tip={`Quest rank ${exp.questRank}`} aria-label={`Rank ${exp.questRank}`}>
              <span class="notice-seal__rank">{exp.questRank}</span>
              <span class="notice-seal__label">rank</span>
            </div>

            <header class="pr-16 sm:pr-20">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] font-mono font-bold uppercase tracking-wider">
                <span class="text-[#b4552c] dark:text-[#f3b354]">{exp.questId}</span>
                <span class="text-[#8a7656] dark:text-[#8fa3bf]">{exp.period}</span>
                <span class="text-[#8a7656] dark:text-[#8fa3bf]">· {exp.location}</span>
                {exp.current && (
                  <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-[#2e7050]/12 text-[#2e7050] dark:bg-emerald-300/15 dark:text-emerald-300">
                    <span class="relative flex h-1.5 w-1.5">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-current opacity-60" />
                      <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-current" />
                    </span>
                    In progress
                  </span>
                )}
              </div>

              <h3 class="mt-2 text-xl sm:text-2xl font-bold leading-snug text-[#2a2620] dark:text-[#f5efe2]">
                {exp.role}
              </h3>
              <p class="mt-0.5 font-serif-story text-base sm:text-lg text-[#23476e] dark:text-[#8cc4f0]">
                at{' '}
                {exp.companyUrl ? (
                  <a
                    href={exp.companyUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold underline decoration-[#c59b47]/60 decoration-2 underline-offset-4 hover:decoration-[#c59b47]"
                  >
                    {exp.company}
                  </a>
                ) : (
                  <span class="font-semibold">{exp.company}</span>
                )}
              </p>
              <p class="mt-2 font-serif-story italic text-sm text-[#6b5d45] dark:text-[#a9b8cc]">“{exp.lore}”</p>
            </header>

            <ul class="mt-4 space-y-2.5 text-[0.92rem] text-[#3d3a33] dark:text-[#cdd7e6] leading-relaxed">
              {exp.description.map((bullet) => (
                <li class="flex items-start gap-3">
                  <svg class="mt-1.5 w-3.5 h-3.5 shrink-0" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M2 14C2 7 6 3 14 2c-1 8-5 12-12 12Zm0 0 7-7" fill="#6aa84f" stroke="#3f7a3a" stroke-width="1" />
                  </svg>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>

            <footer class="mt-5 pt-4 notice-divider flex flex-wrap items-center gap-1.5">
              <span class="sr-only">Technologies:</span>
              {exp.technologies.map((tech) => (
                <span class="seed-tag">{tech}</span>
              ))}
            </footer>
          </article>
        </li>
      ))
    }
    <Acorn id="quests" class="-bottom-6 -left-[15px] z-20" />
  </ol>
</section>
