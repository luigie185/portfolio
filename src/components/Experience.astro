---
import { experiences } from '../data/portfolio';
---

<section id="experience" class="py-14 border-t-2 border-dashed border-[#c59b47]/50">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-2">
    <div>
      <p class="text-xs font-mono font-bold uppercase tracking-widest text-[#2e7050] dark:text-[#59c49d] mb-1">
        📜 SWIFT SOLUTIONS · CAMPAIGN CHRONICLES
      </p>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#252b27] dark:text-[#f5efe2]">
        Main Story Quests (Work Experience)
      </h2>
    </div>
    <p class="text-xs font-mono font-semibold px-3 py-1 rounded-full bg-[#e9dfc4] dark:bg-[#1c2942] text-[#23476e] dark:text-[#f3b354] w-fit">
      COMPLETED & ACTIVE QUESTS: {experiences.length}
    </p>
  </div>

  <div class="relative border-l-2 border-[#c59b47] ml-4 space-y-8">
    {
      experiences.map((exp) => (
        <div class="relative pl-8 group">
          <!-- Quest Marker Diamond -->
          <span
            class:list={[
              'absolute -left-[9px] top-6 h-4 w-4 rotate-45 border-2 transition-transform group-hover:scale-125',
              exp.current
                ? 'bg-[#f3b354] border-[#23476e] dark:border-[#fff8e7] ring-4 ring-[#f3b354]/30'
                : 'bg-[#2e7050] dark:bg-[#59c49d] border-[#fffaf0] dark:border-[#0f1624]',
            ]}
          />

          <div class="rpg-panel rounded-2xl p-6 transition-transform duration-200 hover:-translate-y-0.5">
            <!-- Top Quest Stamp Bar -->
            <div class="flex flex-wrap items-center justify-between gap-2 pb-3 mb-3 border-b border-[#dfd3b8] dark:border-[#2e4063]">
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-md text-[11px] font-mono font-bold bg-[#23476e] text-[#fff8e7] dark:bg-[#f3b354] dark:text-[#111927]">
                  {exp.questId}
                </span>
                <span class="px-2 py-0.5 rounded-md text-[11px] font-mono font-bold border border-[#c59b47] text-[#d4712a] dark:text-[#f3b354]">
                  ★ {exp.questRank}
                </span>
                {exp.current && (
                  <span class="px-2 py-0.5 rounded-md text-[10px] font-mono font-bold bg-emerald-500/20 text-emerald-800 dark:text-emerald-300">
                    ACTIVE QUEST
                  </span>
                )}
              </div>

              <div class="flex items-center gap-2 text-xs font-mono font-bold text-[#2e7050] dark:text-[#59c49d]">
                <span>🏆 {exp.expReward}</span>
                <span class="text-[#c59b47]">•</span>
                <span class="text-[#576058] dark:text-[#9fb0c9]">{exp.period}</span>
              </div>
            </div>

            <!-- Quest Title & Guild -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-3">
              <h3 class="text-lg sm:text-xl font-bold text-[#252b27] dark:text-[#f5efe2]">
                {exp.role}
                <span class="text-[#c59b47] font-normal mx-1.5">@</span>
                {exp.companyUrl ? (
                  <a
                    href={exp.companyUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[#23476e] dark:text-[#68a8e8] hover:underline decoration-[#c59b47] underline-offset-4"
                  >
                    {exp.company}
                  </a>
                ) : (
                  <span class="text-[#23476e] dark:text-[#68a8e8]">{exp.company}</span>
                )}
              </h3>
              <span class="text-xs font-mono text-[#576058] dark:text-[#9fb0c9]">
                📍 {exp.location}
              </span>
            </div>

            <!-- Quest Objectives List -->
            <ul class="mt-3 space-y-2 text-sm text-[#434c44] dark:text-[#c7d3e6] leading-relaxed">
              {exp.description.map((bullet) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-[#d4712a] dark:text-[#f3b354] font-bold mt-0.5 select-none">✔</span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>

            <!-- Equipped Skill Runes -->
            <div class="mt-5 pt-3 border-t border-[#dfd3b8]/60 dark:border-[#2e4063]/60 flex flex-wrap items-center gap-1.5">
              <span class="text-[11px] font-mono font-bold text-[#576058] dark:text-[#9fb0c9] mr-1">
                EQUIPPED RUNES:
              </span>
              {exp.technologies.map((tech) => (
                <span class="px-2.5 py-0.5 text-xs font-mono font-semibold rounded-lg bg-[#efe5ce] dark:bg-[#1e2c45] text-[#23476e] dark:text-[#8ce0c2] border border-[#c59b47]/50">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
